+     * below PHP_INT_MAX) so the cast can never overflow.
+     */
+    private static function guardedId(string $value): int
+    {
+        $raw = (string)$value;
+        if ($raw === '' || !ctype_digit($raw)) {
+            throw new \InvalidArgumentException('Invalid identifier');
+        }
+        $significant = ltrim($raw, '0');
+        if ($significant === '' || strlen($significant) > 18) {
+            throw new \InvalidArgumentException('Invalid identifier');
+        }
+        $id = (int)$raw;
+        if ($id <= 0) {
+            throw new \InvalidArgumentException('Invalid identifier');
+        }
+        return $id;
+    }
