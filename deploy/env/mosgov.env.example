# MOS-GOV 单一教会实例的环境配置模板（纯占位符，禁止提交真实值）
# 由 provision-tenant.sh 渲染到 /etc/mosgov/<tenant>/env，权限 0640 root:mosgov。
# 每个教会一份，互不相同；绝不共用数据库、密钥或存储根目录。
# 所有 __XXX__ 占位符必须在 provision 阶段替换完毕；verify-secrets.sh 会拒绝任何残留。
# root 数据库凭据永远不放进本文件（走 unix_socket 或 /etc/mosgov/.dbroot.cnf）。

# ---- 部署拓扑 ---------------------------------------------------------------
MOSGOV_DEPLOYMENT=public
#  legacy gate 在 public 下已失效，保留仅用于本地 Windows 运行时；严禁 OFF
MOS_GOV_SECURITY_MODE=LOCAL
#  仅填写直接连接本机的反向代理精确 IP，逗号分隔；不接受 CIDR / 网段
MOSGOV_TRUSTED_PROXIES=127.0.0.1

# ---- 教会（租户）标识 -------------------------------------------------------
MOSGOV_TENANT_ID=__TENANT_ID__
MOSGOV_TENANT_DB=__TENANT_DB__
MOSGOV_TENANT_HOST=__TENANT_HOST__
MOSGOV_TENANT_STORAGE=__TENANT_STORAGE__

# ---- 数据库（本教会专属最小权限账号） ----------------------------------------
MOSGOV_DB_HOST=127.0.0.1
MOSGOV_DB_PORT=3306
MOSGOV_DB_USER=__DB_USER__
MOSGOV_DB_PASSWORD=__DB_PASSWORD__

# ---- 审计 HMAC 密钥（库外保存，>=32 字节，绝不入库、绝不入 Git） ------------
MOSGOV_AUDIT_HMAC_KEY=__AUDIT_HMAC_KEY__

# ---- 备份 -------------------------------------------------------------------
MOSGOV_BACKUP_DIR=__BACKUP_DIR__
MOSGOV_BACKUP_RETENTION_DAYS=30
MOSGOV_BACKUP_COS_BUCKET=__BACKUP_COS_BUCKET__
MOSGOV_BACKUP_COS_PREFIX=__BACKUP_COS_PREFIX__
#  COS 凭据用子账号 + 最小权限，放在 /etc/mosgov/<tenant>/cos.env (0400)

# ---- 运行参数 ---------------------------------------------------------------
MOSGOV_RELEASE_COMMIT=__RELEASE_COMMIT__
#  公网下只保留静态存活探针；DB / 证据链检查一律走本机 CLI
MOSGOV_HEALTHCHECK_PATH=/.well-known/mosgov-liveness
